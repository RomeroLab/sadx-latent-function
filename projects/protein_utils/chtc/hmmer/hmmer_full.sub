universe = vanilla

executable = run_hmmer.sh
arguments = jojoba.fasta FULL

log = output/hmmer_full.log
output = output/hmmer_full.out
error = output/hmmer_full.err

should_transfer_files = YES
when_to_transfer_output = ON_EXIT

transfer_input_files = hmmer.tar.gz, jojoba.fasta

# IMPORTANT! Require execute servers that can access /staging
Requirements = (Target.HasCHTCStaging == true)

request_cpus = 4
request_memory = 50GB
request_disk = 150GB

queue
